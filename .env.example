HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Set true behind an HTTPS reverse proxy; never expose over public HTTP.
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
# Minimum 14 characters. Required only to create the first account.
ADMIN_PASSWORD=
# Set false to skip certificate chain/hostname checks for your configured servers.
# Applies only to Proxmox, Hestia, Jellyfin and the pfSense collector.
SERVER_TLS_VERIFY=true
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# Optional physical-host sensors collector; base URL without /metrics.
PROXMOX_SENSORS_URL=
PROXMOX_SENSORS_TOKEN=
HESTIA_URL=
HESTIA_ACCESS_KEY=
HESTIA_SECRET_KEY=
CLOUDFLARE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
HOSTINGER_TOKEN=
JELLYFIN_URL=
JELLYFIN_TOKEN=
STRIPE_WEBHOOK_SECRET=
# Direct pfSense SNMP v2c (requires snmpget/snmpwalk; apt install snmp).
PFSENSE_SNMP_HOST=
PFSENSE_SNMP_PORT=161
PFSENSE_SNMP_COMMUNITY=
PFSENSE_SNMP_INTERFACE=pppoe2
# Optional legacy HTTP collector; ignored when SNMP host/community are configured.
PFSENSE_METRICS_URL=
PFSENSE_METRICS_TOKEN=
# Read subscription limits via a locally installed/logged-in Codex CLI (no model turn).
CODEX_USAGE_ENABLED=false
CODEX_BIN=codex
# Spotify Developer app Client ID; PKCE needs no client secret.
# Register PUBLIC_ORIGIN + /api/spotify/callback as an exact redirect URI.
SPOTIFY_CLIENT_ID=
# Optional service checks. Empty/unset defaults to Orbit itself. JSON stays server-side.
# ORBIT_MONITORS='[{"id":"n8n","name":"n8n","url":"https://YOUR_N8N_HOST/","intervalSeconds":60,"expectedStatus":200}]'
# Allowlisted POST webhooks. token is outbound authentication; callbackToken protects result updates.
ORBIT_AUTOMATIONS=[]
# ORBIT_AUTOMATIONS='[{"id":"workflow","name":"My workflow","url":"https://YOUR_N8N_HOST/webhook/orbit-job","token":"OUTBOUND_SECRET","callbackToken":"A_DIFFERENT_SECRET_AT_LEAST_24_CHARACTERS"}]'
# Optional last-known CLI session status reader on this same host.
CODEX_ACTIVITY_ENABLED=false
# Override when sessions are outside the service user's ~/.codex/sessions.
CODEX_SESSIONS_DIR=
# Separate random 24+ character secret for a Codex computer reporting to Orbit.
ORBIT_ACTIVITY_TOKEN=
